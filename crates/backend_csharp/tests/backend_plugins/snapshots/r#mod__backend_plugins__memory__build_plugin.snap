public interface IPlugin
{
    static abstract void Gc();
    static abstract Task Spin(CancellationToken ct);
}

public interface IFliparoo<TSelf> where TSelf : IFliparoo<TSelf>
{
    static abstract TSelf Create1(Heavy heavy_1, Heavy heavy_2);
    static abstract Task<TSelf> Create2(Heavy heavy1, Heavy heavy2, CancellationToken ct);
    static abstract Task<TSelf> Create3(Heavy heavy1, Heavy heavy3, CancellationToken ct);
    Heavy ReplaceLeft1(Heavy heavy);
    Heavy ReplaceLeft2(Heavy heavy);
    Heavy ReplaceRight1(Heavy heavy);
    Heavy ReplaceRight2(Heavy heavy);
    Task<Heavy> ReplaceLeftAsync(Heavy heavy, CancellationToken ct);
    Task<Heavy> ReplaceRightAsync(Heavy heavy, CancellationToken ct);
    Heavy GetLeft();
    Heavy GetRight();
}

public interface IHeavy<TSelf> where TSelf : IHeavy<TSelf>
{
    static abstract TSelf NewSelf(nuint size, uint value);
    static abstract Task<TSelf> NewSelfAsync(nuint size, CancellationToken ct);
    uint Get(nuint i);
}
