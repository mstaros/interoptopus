public interface IPlugin
{
    static abstract uint Get();
    static abstract Task RunLong(CancellationToken ct);
    static abstract Task<uint> RunLongValue(uint x, CancellationToken ct);
}

public interface IAsyncCancellation<TSelf> where TSelf : IAsyncCancellation<TSelf>
{
    static abstract Task<TSelf> Create(CancellationToken ct);
    Task RunLong(CancellationToken ct);
    Task<uint> RunLongValue(uint x, CancellationToken ct);
    uint Get();
}
