            var parent = _parent;
            while (parent is not null && Volatile.Read(ref parent._disposed)) parent = parent._parent;
            Ambient.Value = parent;
        }
        IDisposable[] resources;
        lock (_gate)
        {
            if (_disposed) return;
            _disposed = true;
            resources = new IDisposable[_resources.Count];
            _resources.CopyTo(resources);
            _resources.Clear();
