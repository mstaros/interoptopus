# Make project render nicely
*.cs linguist-detectable=false
*.py linguist-detectable=false
*.c linguist-detectable=false
*.h linguist-detectable=false
*.sh linguist-detectable=false

# Binary. Previously LFS-tracked; untracked because none of it was large enough to
# earn the cost (the largest committed DLL was 30 KB). Marked binary so that dropping
# the old `-text` flag does not hand these to eol normalization.
*.dll binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary

# Source
*.expected text eol=lf
*.cs text eol=lf
*.h text eol=lf
*.json text eol=lf
*.py text eol=lf
*.snap text eol=lf
*.svg text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
